# ===========================================
# SLMS API Environment Variables
# ===========================================
# Copy this file to .env: cp env.example .env

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# When "true", only @energi-up.com can register. When "false", any email (e.g. local Docker).
# Unset = use NODE_ENV (production -> restrict, development -> allow).
# REGISTRATION_DOMAIN_RESTRICTION_ENABLED=false

# ===========================================
# Database Configuration (Prisma)
# ===========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://slms:slms@localhost:5544/slms?schema=public"

# ===========================================
# Redis Configuration
# ===========================================
# Set to "false" to run without Redis (API will start; queue features disabled). Useful for local dev when Redis is not running.
# REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Uncomment and set for production

# ===========================================
# JWT Configuration
# ===========================================
# Generate secrets with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-replace-in-production
# Access token expiry (s=seconds, m=minutes, h=hours, d=days). Default 8h to avoid frequent re-login.
JWT_EXPIRES_IN=8h
JWT_REFRESH_SECRET=your-refresh-secret-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d

# Admin JWT (separate from user JWT)
JWT_ADMIN_SECRET=your-admin-jwt-secret-replace-in-production
JWT_ADMIN_EXPIRES_IN=8h

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins. Must include exact Next.js origin for cookie-based auth.
# 127.0.0.1 variants are allowed automatically for any localhost:PORT you list.
CORS_ORIGINS=http://localhost:3000,http://localhost:3002,http://localhost:3003,http://localhost:3004,http://localhost:1337,http://localhost:3001

# ===========================================
# Swagger Configuration
# ===========================================
SWAGGER_ENABLED=true

# ===========================================
# SMTP Configuration (Email)
# ===========================================
# For local development, you can point this to Mailhog/Mailpit or a real SMTP server.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SLMS Notifications <noreply@slms.local>

# Alternative "from" configuration (preferred for new features)
MAIL_FROM_NAME=SLMS Notifications
MAIL_FROM_ADDRESS=noreply@slms.local

# Base URL used in auth emails (verification link). Must be a full URL (http:// or https://)
# so email clients open it in the browser. Use the public URL where the Next.js app
# is reachable (e.g. https://portal.example.com).
APP_BASE_URL=http://localhost:3000

# For production with real SMTP server:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=SLMS Notifications <noreply@example.com>

# ===========================================
# Notification Job Configuration
# ===========================================
# Enable/disable the scheduled notification job
NOTIFICATION_JOB_ENABLED=true

# Web URL for notification emails (link to portal)
WEB_URL=http://localhost:3000

# ===========================================
# MinIO (Document Storage)
# ===========================================
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=slms-docs
MINIO_PUBLIC_URL=http://localhost:9000/slms-docs

# ===========================================
# Future: Keycloak OIDC Configuration
# ===========================================
# Uncomment when integrating Keycloak
# KEYCLOAK_REALM=slms
# KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
# KEYCLOAK_CLIENT_ID=slms-api
# KEYCLOAK_CLIENT_SECRET=your-client-secret
# KEYCLOAK_CALLBACK_URL=http://localhost:3001/api/v1/auth/keycloak/callback
