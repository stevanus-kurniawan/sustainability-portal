# ===========================================
# SLMS API Environment Variables
# ===========================================
# Copy this file to .env: cp env.example .env

# ===========================================
# Server Configuration
# ===========================================
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1

# ===========================================
# Database Configuration (Prisma)
# ===========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://slms:slms@localhost:5544/slms?schema=public"

# ===========================================
# Redis Configuration
# ===========================================
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=  # Uncomment and set for production

# ===========================================
# JWT Configuration
# ===========================================
# Generate secrets with: openssl rand -base64 64
JWT_SECRET=your-jwt-secret-replace-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-replace-in-production
JWT_REFRESH_EXPIRES_IN=7d

# ===========================================
# CORS Configuration
# ===========================================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000,http://localhost:1337,http://localhost:3001

# ===========================================
# Swagger Configuration
# ===========================================
SWAGGER_ENABLED=true

# ===========================================
# Strapi CMS Configuration
# ===========================================
# Strapi API URL (without /api suffix)
STRAPI_URL=http://localhost:1337

# Strapi API Token (generate in Strapi Admin > Settings > API Tokens)
# Create a token with "Full access" for admin operations
STRAPI_API_TOKEN=your-strapi-api-token

# ===========================================
# SMTP Configuration (Email)
# ===========================================
# For local development with Mailhog:
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SLMS Notifications <noreply@slms.local>

# For production with real SMTP server:
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=SLMS Notifications <noreply@example.com>

# ===========================================
# Notification Job Configuration
# ===========================================
# Enable/disable the scheduled notification job
NOTIFICATION_JOB_ENABLED=true

# Web URL for notification emails (link to portal)
WEB_URL=http://localhost:3000

# ===========================================
# Future: Keycloak OIDC Configuration
# ===========================================
# Uncomment when integrating Keycloak
# KEYCLOAK_REALM=slms
# KEYCLOAK_AUTH_SERVER_URL=http://localhost:8080
# KEYCLOAK_CLIENT_ID=slms-api
# KEYCLOAK_CLIENT_SECRET=your-client-secret
# KEYCLOAK_CALLBACK_URL=http://localhost:3001/api/v1/auth/keycloak/callback
