# ===========================================
# SLMS CMS (Strapi) Environment Variables
# ===========================================
# Copy this file to .env: cp env.example .env
# Generate secrets: openssl rand -base64 32

# ===========================================
# Server Configuration
# ===========================================
HOST=0.0.0.0
PORT=1337
PUBLIC_URL=http://localhost:1337

# ===========================================
# Database Configuration (PostgreSQL)
# ===========================================
DATABASE_HOST=localhost
DATABASE_PORT=5544
DATABASE_NAME=slms
DATABASE_USERNAME=slms
DATABASE_PASSWORD=slms
DATABASE_SSL=false
DATABASE_SCHEMA=public

# ===========================================
# Object Storage Configuration
# ===========================================
# Supports S3-compatible storage: MinIO, Alibaba Cloud OSS, etc.
#
# --- For MinIO (Local Development) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=slms-docs
STORAGE_ACCESS_KEY_ID=minioadmin
STORAGE_ACCESS_KEY_SECRET=minioadmin
STORAGE_REGION=us-east-1
STORAGE_FORCE_PATH_STYLE=true
# STORAGE_BASE_URL=  # Leave empty, will use STORAGE_ENDPOINT/STORAGE_BUCKET
#
# --- For Alibaba Cloud OSS (Production) ---
# STORAGE_ENDPOINT=https://oss-ap-southeast-5.aliyuncs.com
# STORAGE_BUCKET=your-bucket-name
# STORAGE_ACCESS_KEY_ID=your-aliyun-access-key-id
# STORAGE_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
# STORAGE_REGION=oss-ap-southeast-5
# STORAGE_FORCE_PATH_STYLE=false
# STORAGE_BASE_URL=https://your-bucket-name.oss-ap-southeast-5.aliyuncs.com

# ===========================================
# App Keys (comma-separated, min 4 keys)
# Generate with: openssl rand -base64 32
# ===========================================
APP_KEYS=key1_replace_me_with_random_string,key2_replace_me_with_random_string,key3_replace_me_with_random_string,key4_replace_me_with_random_string

# ===========================================
# Admin JWT Secret
# Generate with: openssl rand -base64 32
# ===========================================
ADMIN_JWT_SECRET=replace_me_with_random_admin_jwt_secret

# ===========================================
# API Token Salt
# Generate with: openssl rand -base64 32
# ===========================================
API_TOKEN_SALT=replace_me_with_random_api_token_salt

# ===========================================
# Transfer Token Salt
# Generate with: openssl rand -base64 32
# ===========================================
TRANSFER_TOKEN_SALT=replace_me_with_random_transfer_token_salt

# ===========================================
# JWT Secret for Users & Permissions plugin
# Generate with: openssl rand -base64 32
# ===========================================
JWT_SECRET=replace_me_with_random_jwt_secret
