# Next.js public API URL (NestJS backend)
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1

# Registration domain restriction: set to "true" only in production so only @energi-up.com can register.
# Leave unset or "false" for dev/local to allow any email.
# NEXT_PUBLIC_REGISTRATION_DOMAIN_RESTRICTION_ENABLED=true
