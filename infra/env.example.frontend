# ===========================================
# Production FRONTEND server – environment variables
# ===========================================
# Copy to infra/.env on the FRONTEND server:
#   cp env.example.frontend .env
# Then edit .env with your server IPs and run:
#   docker compose -f infra/docker-compose.prod.frontend.yml up -d
#
# Port: 8000. API_BACKEND_URL must be reachable from this server (backend IP:8001).

# -------------------------------------------
# API URL – what the browser uses (same-origin when using proxy)
# Use this server’s IP until domain is ready (e.g. http://192.168.1.10:8000/api/v1)
# -------------------------------------------
API_URL=http://YOUR_FRONTEND_SERVER_IP:8000/api/v1

# -------------------------------------------
# Backend API – used by Next.js server to proxy /api/v1 and for login cookie
# Use backend server IP and port 8001
# -------------------------------------------
API_BACKEND_URL=http://YOUR_BACKEND_SERVER_IP:8001

# -------------------------------------------
# Optional
# -------------------------------------------
# CMS_URL=
