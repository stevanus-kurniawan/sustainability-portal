{
  "name": "slms",
  "version": "1.0.0",
  "private": true,
  "description": "Sustainability Certification and Licensing Management System - Monorepo",
  "keywords": [
    "sustainability",
    "certification",
    "licensing",
    "management"
  ],
  "license": "UNLICENSED",
  "author": "SLMS Team",
  "scripts": {
    "dev": "concurrently -n infra,api,web -c cyan,blue,green \"pnpm dev:infra\" \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:web": "pnpm --filter @slms/web dev",
    "dev:api": "pnpm --filter @slms/api start:dev",
    "dev:infra": "cd infra && docker-compose up -d",
    "dev:infra:logs": "cd infra && docker-compose logs -f",
    "dev:infra:down": "cd infra && docker-compose down",
    "dev:infra:reset": "cd infra && docker-compose down -v",
    "setup:env": "node -e \"const fs=require('fs');const cp=(s,d)=>{if(!fs.existsSync(d)){fs.copyFileSync(s,d);console.log('Created '+d);}};cp('apps/api/env.example','apps/api/.env');cp('apps/web/env.example','apps/web/.env.local');\"",
    "build": "pnpm run --parallel build",
    "build:shared": "pnpm --filter @slms/shared build",
    "build:web": "pnpm --filter @slms/web build",
    "build:api": "pnpm --filter @slms/api build",
    "build:docker": "docker compose -f infra/docker-compose.yml build",
    "docker:up": "docker compose -f infra/docker-compose.yml up -d --build",
    "docker:down": "docker compose -f infra/docker-compose.yml down",
    "docker:restart": "docker compose -f infra/docker-compose.yml restart api web",
    "docker:rebuild": "docker compose -f infra/docker-compose.yml up -d --build api web",
    "lint": "pnpm run --parallel lint",
    "lint:fix": "pnpm run --parallel lint:fix",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css,scss}\"",
    "clean": "pnpm run --parallel clean && rimraf node_modules",
    "typecheck": "pnpm run --parallel typecheck",
    "prepare": "husky install",
    "db:generate": "pnpm --filter @slms/api prisma:generate",
    "db:migrate": "pnpm --filter @slms/api prisma:migrate:dev",
    "db:migrate:prod": "pnpm --filter @slms/api prisma:migrate",
    "db:seed": "pnpm --filter @slms/api prisma:seed",
    "db:studio": "pnpm --filter @slms/api prisma:studio",
    "db:reset": "pnpm --filter @slms/api prisma:reset",
    "setup": "pnpm install && pnpm build:shared && pnpm setup:env && pnpm dev:infra && node -e \"console.log('Waiting 25s for Postgres...');setTimeout(()=>{},25000)\" && pnpm db:migrate && pnpm db:seed"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "@typescript-eslint/eslint-plugin": "^6.13.0",
    "@typescript-eslint/parser": "^6.13.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.55.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-import": "^2.29.0",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "rimraf": "^5.0.5",
    "typescript": "^5.3.2"
  },
  "packageManager": "pnpm@8.12.0",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=8.0.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
